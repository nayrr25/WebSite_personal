# Public site URL — used by metadataBase, sitemap, robots, and OG image.
# Vercel: set this in Project → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://n-ai.dev

# Google Tag Manager.
# NO hace falta configurar nada en Vercel: el ID por defecto vive en
# src/components/analytics/GoogleTagManager.tsx y el codigo usa la variable
# NEXT_PUBLIC_VERCEL_ENV (que Vercel inyecta sola) para cargar GTM solo en
# produccion. En local y en previews no carga, asi las metricas quedan limpias
# de trafico propio.
#
# NEXT_PUBLIC_GTM_ID   -> solo si algun dia hay que apuntar a otro contenedor.
# NEXT_PUBLIC_GTM_FORCE=1 -> fuerza la carga en local/preview para depurar.
